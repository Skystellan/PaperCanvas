{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "fs:allow-read-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/papers" },
        { "path": "$APPDATA/papers/*" }
      ]
    },
    "sql:default",
    "sql:allow-execute"
  ]
}
